# Owner account created on an empty store. All three are required together.
# No account is invented when they are blank.
STOCKFLOW_OWNER_EMAIL=
STOCKFLOW_OWNER_NAME=
STOCKFLOW_OWNER_PASSWORD=

# Optional reference data. Warehouses, companies, materials, and packaging only.
# Do not put purchase orders, shipments, requests, or stock in this value.
# {"warehouses":[{"name":"Bornem","country":"Belgium"},{"name":"Turnhout","country":"Belgium"},{"name":"Spain","country":"Spain"},{"name":"Pakistan","country":"Pakistan"}],"companies":[{"name":"Meridian Packaging","kind":"customer"}],"materials":[{"materialNumber":"LDPE","description":"LDPE film","unit":"kg","lowStockThresholdKg":25}],"packagingTypes":[{"name":"Normal Pallet","tareKg":25}]}
STOCKFLOW_REFERENCE_JSON=

# Optional path for the local JSON store. Defaults to data/warehouse-store.json.
STOCKFLOW_STORE_PATH=

# Data adapter selection: "local" (default, JSON store) or "supabase" (PostgreSQL + RLS + Storage)
STOCKFLOW_DATA_ADAPTER=local

# Supabase configuration (required when STOCKFLOW_DATA_ADAPTER=supabase)
# Never commit real keys or service-role secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=stockflow-files
